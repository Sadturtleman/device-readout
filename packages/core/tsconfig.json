{
  "compilerOptions": {
    "target": "ES2020", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2020", "DOM"], "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "declaration": true,
    "outDir": "dist", "rootDir": "src", "skipLibCheck": false,
    "noImplicitOverride": true, "useDefineForClassFields": true
  },
  "include": ["src/**/*.ts"]
}
