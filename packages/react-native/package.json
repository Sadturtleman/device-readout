{
  "name": "@device-readout/react-native",
  "version": "0.1.0",
  "description": "DeviceReadout React Native binding",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "browser": "./dist/index.web.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "files": ["src", "dist", "scripts", "android/src", "android/shared", "android/build.gradle", "android/resolve-package.cjs", "android/settings.gradle", "android/gradle.properties", "README.md"],
  "scripts": {"prepack": "node scripts/prepare-package.mjs"},
  "exports": {
    ".": {
      "browser": {"types": "./dist/index.web.d.ts", "default": "./dist/index.web.js"},
      "react-native": {"types": "./dist/index.d.ts", "default": "./src/index.ts"},
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {"types": "./dist/index.web.d.ts", "default": "./dist/index.web.js"},
    "./package.json": "./package.json"
  },
  "peerDependencies": {"react-native": "0.88.x", "react-native-web": "0.21.x"},
  "peerDependenciesMeta": {"react-native": {"optional": true}, "react-native-web": {"optional": true}},
  "dependencies": {"@device-readout/core": "0.1.0", "@device-readout/web": "0.1.0"},
  "codegenConfig": {"name": "DeviceReadoutSpec", "type": "modules", "jsSrcsDir": "src/specs", "android": {"javaPackageName": "dev.devicereadout.reactnative"}}
}
